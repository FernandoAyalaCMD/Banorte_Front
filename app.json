{
  "expo": {
    "name": "Banorte A2UI",
    "slug": "banorte-a2ui",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.banorte.a2ui",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Banorte necesita acceso al micrófono para comandos de voz."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#EB0029",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.banorte.a2ui",
      "permissions": [
        "RECORD_AUDIO"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-audio"
    ],
    "extra": {
      "eas": {
        "projectId": "banorte-a2ui-hackathon"
      }
    }
  }
}
